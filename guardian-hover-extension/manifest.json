{
  "manifest_version": 3,
  "name": "Guardian Hover Verdict",
  "version": "0.1.0",
  "description": "Shows Guardian backend verdict (SAFE/SUS/NOT SAFE) when hovering links.",
  "permissions": [],
  "host_permissions": [
    "https://guardian-back.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
