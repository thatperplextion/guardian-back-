{
  "manifest_version": 3,
  "name": "Guardian Hover Verdict",
  "version": "0.1.2",
  "description": "Shows Guardian backend verdict (SAFE/SUS/NOT SAFE) when hovering links.",
  "permissions": [],
  "host_permissions": ["https://guardian-back.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

